{
    "name": "ricasolucoes/atlassian",
    "description": "PHP ATLASSIAN INTEGRATION - JIRA and Confluence Rest Client API for PHP Users.",
    "type": "library",
    "keywords": [
        "jira",
        "confluence",
        "rest",
        "jira-php",
        "jira-rest"
    ],
    "homepage": "https://github.com/ricasolucoes/atlassian",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "ext-curl": "*",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^7.10",
        "league/flysystem": "^3.36",
        "laravel/helpers": "^1.8",
        "lesstif/php-jira-rest-client": "^5.12"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^4.4",
        "barryvdh/laravel-ide-helper": "^3.7",
        "fakerphp/faker": "^1.23",
        "friendsofphp/php-cs-fixer": "^3.68",
        "laravel/dusk": "^8.6",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^11.0",
        "phpro/grumphp": "^2.12",
        "phpunit/phpunit": "^13.0",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "suggest": {
        "netresearch/jsonmapper": "^3.0",
        "vlucas/phpdotenv": "^5.0"
    },
    "authors": [
        {
            "name": "RiCa Soluções",
            "email": "contato@ricasolucoes.com.br",
            "homepage": "https://ricasolucoes.com.br"
        }
    ],
    "autoload": {
        "psr-4": {
            "Atlassian\\": "src"
        }
    },
    "autoload-dev": {
        "classmap": [
            "tests/"
        ],
        "psr-4": {
            "Atlassian\\Tests\\": "tests/Tests/",
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Atlassian\\AtlassianProvider"
            ],
            "aliases": {
                "Atlassian": "Atlassian\\Facades\\Atlassian"
            },
            "dont-discover": []
        }
    },
    "scripts": {
        "post-install-cmd": [],
        "post-update-cmd": [],
        "post-create-project-cmd": [],
        "psalm": "vendor/bin/psalm",
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage",
        "format": "vendor/bin/php-cs-fixer fix --allow-risky=yes"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "phpro/grumphp": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "version": "2.3.0"
}
